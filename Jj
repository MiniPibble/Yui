makeDraggable(bubble, bubble,
    function()
        bubbleDragging = false
        tween(bubbleScale, EASE_FAST, { Scale = 1.12 })
    end,
    function()
        tween(bubbleScale, EASE_SETTLE, { Scale = 1 })
    end
)

-- treat a real drag vs a tap: if pointer moved more than a few pixels, don't reopen
local pressPos
bubble.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        pressPos = input.Position
    end
end)

bubble.MouseButton1Click:Connect(function()
    hideBubble()
    closing = false
    frame.Visible = true
    frame.Rotation = 0
    frame.BackgroundTransparency = 0
    frameStroke.Transparency = 0
    frameScale.Scale = 0.75
    tween(frameScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
    tween(ambientGlow, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.93 })
end)

-- Call e.g. _G.YuiAddEntry(1, "Name", "TAG", "Value") to add a row to Tab 1
local function AddEntry(tabIndex, name, tag, value)
    local list = panels[tabIndex]:FindFirstChild("List")
    if not list then return end

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = THEME.Panel2,
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
        Parent = list,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 5), Parent = row })
    new("UIStroke", { Color = THEME.Line, Thickness = 1, Parent = row })
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
        Parent = row,
    })
    tween(row, EASE_FADE, { BackgroundTransparency = 0 })

    new("TextLabel", {
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 10.5,
        TextColor3 = THEME.TextHi,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(0.5, 1),
        Parent = row,
    })
    new("TextLabel", {
        Text = tag or "",
        Font = Enum.Font.Code,
        TextSize = 8.5,
        TextColor3 = THEME.Accent,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2.fromScale(0.5, 0),
        Size = UDim2.fromScale(0.25, 1),
        Parent = row,
    })
    new("TextLabel", {
        Text = value or "",
        Font = Enum.Font.Code,
        TextSize = 9.5,
        TextColor3 = THEME.TextMid,
        TextXAlignment = Enum.TextXAlignment.Right,
        BackgroundTransparency = 1,
        Position = UDim2.fromScale(0.75, 0),
        Size = UDim2.fromScale(0.25, 1),
        Parent = row,
    })
end

_G.YuiAddEntry = AddEntry

-- entrance animation (springy pop + fade)
frameScale.Scale = 0.75
frame.BackgroundTransparency = 1
frameStroke.Transparency = 1
ambientGlow.BackgroundTransparency = 1
tween(frameScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
tween(frame, EASE_FADE, { BackgroundTransparency = 0 })
tween(frameStroke, EASE_FADE, { Transparency = 0 })
tween(ambientGlow, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.93 })

return screenGui
