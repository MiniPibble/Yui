local activeIndex = 1

local function setActiveTab(index)
    if index == activeIndex then return end

    tween(indicator, EASE_SLIDE, {
        Position = UDim2.new((index - 1) / 5, 0, 0, 0),
    })

    for i, lbl in ipairs(labels) do
        tween(lbl, EASE_FAST, { TextColor3 = (i == index) and THEME.TextHi or THEME.TextLow })
    end

    local oldIndex = activeIndex
    local oldGroup = groups[oldIndex]
    local newGroup = groups[index]

    panels[index].Visible = true
    newGroup.GroupTransparency = 1
    newGroup.Position = UDim2.fromOffset(0, 6)
    tween(newGroup, EASE_FADE, { GroupTransparency = 0 })
    tween(newGroup, EASE_POP, { Position = UDim2.fromOffset(0, 0) })

    local fadeOut = tween(oldGroup, EASE_FADE, { GroupTransparency = 1 })
    fadeOut.Completed:Connect(function()
        panels[oldIndex].Visible = false
    end)

    activeIndex = index
end

